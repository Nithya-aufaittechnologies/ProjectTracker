@model IEnumerable<MpcFabricsTracker.Models.WeeklyCapacity>
@{
    ViewData["Title"] = "Weekly Capacity";
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-start gap-3">
    <div>
        <p class="eyebrow">Manual inputs</p>
        <h1>Weekly Capacity</h1>
        <p class="subtitle">Planned hours, leave, assigned hours, and total tasks assigned (manual).</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Add capacity</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="table-responsive card-panel">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Week</th>
                <th>Developer</th>
                <th class="text-end">Planned Hrs</th>
                <th class="text-end">Leave Hrs</th>
                <th class="text-end">Capacity</th>
                <th class="text-end">Assigned Hrs</th>
                <th class="text-end">Tasks Assigned</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Week?.Label</td>
                <td>@item.Developer?.Name</td>
                <td class="text-end">@item.PlannedHours.ToString("0.##")</td>
                <td class="text-end">@item.PlannedLeaveHours.ToString("0.##")</td>
                <td class="text-end">@item.ActualCapacity.ToString("0.##")</td>
                <td class="text-end">@item.AssignedHours.ToString("0.##")</td>
                <td class="text-end">@item.TotalTaskAssigned</td>
                <td class="text-end"><a asp-action="Edit" asp-route-id="@item.Id">Edit</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
