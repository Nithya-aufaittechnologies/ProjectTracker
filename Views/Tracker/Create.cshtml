@model MpcFabricsTracker.Models.TrackerEntry
@{
    ViewData["Title"] = "Add Tracker Entry";
}

<div class="page-header">
    <h1>Add Tracker Entry</h1>
    <p class="subtitle">Log a day-wise task for a developer.</p>
</div>

<div class="card-panel form-panel">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <partial name="_TrackerForm" />
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
